{
  "expo": {
    "name": "SliceLife",
    "slug": "SliceLife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/1.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/1.png",
        "backgroundColor": "#ffffff"
        
      },
      "package": "com.anonymous.SliceLife"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/1.png",
          "imageWidth":200,
          "resizeMode": "containt",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
